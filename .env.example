# =============================================================================
# Enterprise Sizing & Capacity Planning Suite - Environment Configuration
# =============================================================================

# Timezone
TZ=Asia/Jakarta

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Microsoft SQL Server / Azure SQL Edge / Postgres)
# -----------------------------------------------------------------------------
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=PasswordKuat123!
# Note: Password URL-encoded untuk simbol khusus seperti ! (%21), @ (%40), # (%23)
DB_PASSWORD_ENCODED=PasswordKuat123%21

# Default connection ke service container 'db' di dalam Docker Compose:
DATABASE_URL=sqlserver://sa:PasswordKuat123%21@db:1433?database=sizing&trustServerCertificate=true

# Contoh jika ingin connect ke DB eksternal / PostgreSQL:
# DATABASE_URL=postgres://postgres:Password123@host.docker.internal:5432/sizing?sslmode=disable
# DATABASE_URL=sqlserver://sa:Password123@vps-ip:1433?database=sizing&trustServerCertificate=true

# -----------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Golang Fiber)
# -----------------------------------------------------------------------------
BACKEND_PORT=8089
CORS_ORIGINS=*
TEMPLATES_DIR=/app/templates

# -----------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (Nuxt 3)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
# URL yang diakses oleh BROWSER pengguna untuk memanggil backend:
# - Jika direct port: http://localhost:8089 (atau http://IP_SERVER:8089)
# - Jika menggunakan gateway / reverse proxy / domain yang sama: kosongkan "" atau gunakan /api
NUXT_PUBLIC_API_BASE=http://localhost:8089
API_BASE=http://localhost:8089

# URL internal antar container di network Docker:
BACKEND_INTERNAL_URL=http://backend:8089

# -----------------------------------------------------------------------------
# 4. OPTIONAL: GATEWAY REVERSE PROXY (Nginx - Single Port)
# Jalankan dengan: docker compose --profile gateway up -d
# -----------------------------------------------------------------------------
GATEWAY_PORT=80
